            {
                filterLinQ = "entity => entity.Activa == true"
            };
            public filtrarCajasPorPrecioApertura::ReadFilter (p_precioMinimo : Double, p_precioMaximo : Double) : List<Object -> CajaMisteriosa>
            {
                filterLinQ = "entity => (double)entity.PrecioApertura.Valor >= p_precioMinimo && (double)entity.PrecioApertura.Valor <= p_precioMaximo"
            };
        }
    };


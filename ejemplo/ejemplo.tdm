ConceptualModel SkinLink {

    // ==========================================
    // ENUMERACIONES
    // ==========================================

    Enumeration EstadoCuenta
    {
        (Activo, 1), (Suspendido, 2)
    };

    Enumeration Rareza
    {
        (Extraordinario, 1), (Raro, 2), (Especial, 3), (PocoComun, 4), (Comun, 5)
    };

    Enumeration Condicion
    {
        (RecienFabricado, 1), (DesgasteMinimo, 2), (AlgoDesgastado, 3), (BastanteDesgastado, 4), (Deplorable, 5)
    };

    Enumeration TipoTransaccion
    {
        (Deposito, 1), (Retiro, 2), (CobroVenta, 3), (PagoVenta, 4), (CosteCaja, 5)
    };

    Enumeration EstadoVenta
    {
        (Disponible, 1), (EnProceso, 2), (Completada, 3), (Cancelada, 4)
    };

    // blanca
    Enumeration EstadoIntercambio
    {
        (Pendiente, 1), (Aceptado, 2), (Rechazado, 3), (Cancelado, 4)
    };

    // ==========================================
    // VALUE OBJECTS
    // ==========================================

    Class AtributosSkin <ValueObject>
    {
        attributes
        {
            private rareza : Rareza (1, 1);
            private condicion : Condicion (1, 1);
            private floatVal : Double (1, 1);
            private patron : Integer (1, 1);
        }
    };

    Class Moneda <ValueObject>
    {
        attributes
        {
            private valor : Double (1, 1);
            private divisa : String (1, 1);
        }
    };

    // ==========================================
    // USUARIOS (<User>)
    // ==========================================

    Class Usuario <User>
    {
        attributes
        {
            private oid isToken id : Autogenerated (1, 1);
            private nombreUsuario : String (1, 1);
            private correo : String (1, 1);
            private contrasena : Password (1, 1);
            private fechaNacimiento : Date (1, 1);
            private estado : EstadoCuenta (1, 1);
            private nivel : Integer (1, 1);
            private experiencia : Integer (1, 1);
            private fechaUltimoLogin : Date (1, 1);
            private temaModoOscuro : Boolean (1, 1);
            private idioma : String (1, 1);
            private verificado : Boolean (1, 1);
            // Jorge
            private fechaUltimaRecompensa : Date (0, 1);
        }
        
        operations
        {
            public new::New (p_nombreUsuario : String, p_correo : String, p_contrasena : Password, p_fechaNacimiento : Date, p_estado : EstadoCuenta, p_nivel : Integer, p_experiencia : Integer, p_fechaUltimoLogin : Date, p_temaModoOscuro : Boolean, p_idioma : String, p_verificado : Boolean, p_monedero : Object -> Monedero, p_inventario : Object -> InventarioPrivado) : Object -> Usuario;
            public destroy::Destroy (p_oid : OID -> Usuario) : Void;
            public modify::Modifier (p_oid : OID -> Usuario, p_nombreUsuario : String, p_correo : String, p_contrasena : Password, p_fechaNacimiento : Date, p_estado : EstadoCuenta, p_nivel : Integer, p_experiencia : Integer, p_fechaUltimoLogin : Date, p_temaModoOscuro : Boolean, p_idioma : String, p_verificado : Boolean, p_monedero : Object -> Monedero, p_inventario : Object -> InventarioPrivado) : Void;
            public readOID::ReadOID (p_oid : OID -> Usuario) : Object -> Usuario;
            public readAll::ReadAll () : List<Object -> Usuario>;
            
            // Login nativo de HARIA
            public login::Login (p_oid : OID -> Usuario, p_password : Password) : String;
            
            // Operaciones Custom
            public sumarExperiencia::Custom (p_oid : OID -> Usuario, p_puntos : Integer) : Void;
            public suspenderCuentaUsuario::Custom (p_oid : OID -> Usuario) : Void;
            public verificarUsuario::Custom (p_oid : OID -> Usuario) : Void;

            // Jorge
            public reclamarRecompensaDiaria::CustomTransaction (p_oid : OID -> Usuario, p_caja_oid : OID -> CajaMisteriosa) : Object -> ActivoDigital;

            // ========================================================
            // FILTROS DE LECTURA (ReadFilter) - Modulo Financiero y Auditoria
            // ========================================================
            public filtrarUsuariosPorEstado::ReadFilter (p_estado : EstadoCuenta) : List<Object -> Usuario>
            {
                filterLinQ = "entity => entity.Estado == p_estado"
            };
        }
    };

    Class Administrador extends Usuario
    {
        attributes
        {
            private codigoAuditor : String (1, 1);
        }
        
        operations
        {
            public new::New (p_nombreUsuario : String, p_correo : String, p_contrasena : Password, p_fechaNacimiento : Date, p_estado : EstadoCuenta, p_nivel : Integer, p_experiencia : Integer, p_fechaUltimoLogin : Date, p_temaModoOscuro : Boolean, p_idioma : String, p_verificado : Boolean, p_monedero : Object -> Monedero, p_inventario : Object -> InventarioPrivado, p_codigoAuditor : String) : Object -> Administrador;
            public destroy::Destroy (p_oid : OID -> Administrador) : Void;
            public modify::Modifier (p_oid : OID -> Administrador, p_nombreUsuario : String, p_correo : String, p_contrasena : Password, p_fechaNacimiento : Date, p_estado : EstadoCuenta, p_nivel : Integer, p_experiencia : Integer, p_fechaUltimoLogin : Date, p_temaModoOscuro : Boolean, p_idioma : String, p_verificado : Boolean, p_monedero : Object -> Monedero, p_inventario : Object -> InventarioPrivado, p_codigoAuditor : String) : Void;
            public readOID::ReadOID (p_oid : OID -> Administrador) : Object -> Administrador;
            public readAll::ReadAll () : List<Object -> Administrador>;
            
            // Operaciones Custom de Administracion
            public actualizarEstadoKYC::Custom (p_oid : OID -> Administrador, p_usuario_oid : OID -> Usuario, p_nuevoEstado : EstadoCuenta) : Void;
        }
    };

    // ==========================================
    // MONEDERO Y TRANSACCIONES
    // ==========================================

    Class Monedero
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private saldoDisponible : Moneda (1, 1);
            private saldoPendiente : Moneda (1, 1);
        }
        
        operations
        {
            public new::New (p_saldoDisponible : Moneda, p_saldoPendiente : Moneda, p_usuario_oid : OID -> Usuario) : Object -> Monedero;
            public destroy::Destroy (p_oid : OID -> Monedero) : Void;
            public modify::Modifier (p_oid : OID -> Monedero, p_saldoDisponible : Moneda, p_saldoPendiente : Moneda) : Void;
            public readOID::ReadOID (p_oid : OID -> Monedero) : Object -> Monedero;
            public readAll::ReadAll () : List<Object -> Monedero>;
            
            // Operaciones Custom
            public incrementarSaldo::Custom (p_oid : OID -> Monedero, p_montoAnadir : Moneda) : Void;
            public decrementarSaldo::Custom (p_oid : OID -> Monedero, p_montoRestar : Moneda) : Void;

            // Casos de uso (CustomTransaction)
            public depositarFondos::CustomTransaction (p_oid : OID -> Monedero, p_monto : Moneda, p_referenciaPago : String, p_pagoConfirmado : Boolean) : Object -> Transaccion;
            public retirarSaldoWallet::CustomTransaction (p_oid : OID -> Monedero, p_monto : Moneda, p_destino : String) : Object -> Transaccion;
        }
    };

    Class Transaccion
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private tipo : TipoTransaccion (1, 1);
            private monto : Moneda (1, 1);
            private fecha : Date (1, 1);
            private concepto : String (1, 1);
        }
        
        operations
        {
            public new::New (p_tipo : TipoTransaccion, p_monto : Moneda, p_fecha : Date, p_concepto : String, p_monedero_oid : OID -> Monedero) : Object -> Transaccion;
            public destroy::Destroy (p_oid : OID -> Transaccion) : Void;
            public modify::Modifier (p_oid : OID -> Transaccion, p_tipo : TipoTransaccion, p_monto : Moneda, p_fecha : Date, p_concepto : String) : Void;
            public readOID::ReadOID (p_oid : OID -> Transaccion) : Object -> Transaccion;
            public readAll::ReadAll () : List<Object -> Transaccion>;
            
            // Operacion Custom
            public validarSaldoMonedero::Custom (p_oid : OID -> Transaccion, p_monedero_oid : OID -> Monedero, p_montoRequerido : Moneda) : Boolean;

            // ========================================================
            // FILTROS DE LECTURA (ReadFilter) - Modulo Financiero y Auditoria
            // ========================================================
            public filtrarTransaccionesPorTipo::ReadFilter (p_tipo : TipoTransaccion) : List<Object -> Transaccion>
            {
                filterLinQ = "entity => entity.Tipo == p_tipo"
            };
            public filtrarTransaccionesPorRangoFechas::ReadFilter (p_fechaInicio : Date, p_fechaFin : Date) : List<Object -> Transaccion>
            {
                filterLinQ = "entity => entity.Fecha >= p_fechaInicio && entity.Fecha <= p_fechaFin"
            };
        }
    };

    // ==========================================
    // INVENTARIO Y ACTIVOS DIGITALES
    // ==========================================

    Class InventarioPrivado
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private valorEstimadoTotal : Moneda (1, 1);
            // blanca
            private esPublico : Boolean (1, 1);
        }
        
        operations
        {
            public new::New (p_valorEstimadoTotal : Moneda, p_esPublico : Boolean, p_usuario_oid : OID -> Usuario, p_activos : List<Object -> ActivoDigital>) : Object -> InventarioPrivado;
            public destroy::Destroy (p_oid : OID -> InventarioPrivado) : Void;
            public modify::Modifier (p_oid : OID -> InventarioPrivado, p_valorEstimadoTotal : Moneda, p_esPublico : Boolean) : Void;
            public readOID::ReadOID (p_oid : OID -> InventarioPrivado) : Object -> InventarioPrivado;
            public readAll::ReadAll () : List<Object -> InventarioPrivado>;

            // blanca
            public cambiarVisibilidadInventario::Custom (p_oid : OID -> InventarioPrivado) : Boolean;
        }
    };

    Class ArticuloCatalogo
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private nombre : String (1, 1);
            private coleccion : String (1, 1);
            private rareza : Rareza (1, 1);
            private precioReferencia : Moneda (1, 1);
            private habilitado : Boolean (1, 1);
            private porcentajeDescuento : Double (0, 1);
            private fechaFinDescuento : Date (0, 1);
        }
        
        operations
        {
            public new::New (p_nombre : String, p_coleccion : String, p_rareza : Rareza, p_precioReferencia : Moneda, p_habilitado : Boolean, p_porcentajeDescuento : Double, p_fechaFinDescuento : Date) : Object -> ArticuloCatalogo;
            public destroy::Destroy (p_oid : OID -> ArticuloCatalogo) : Void;
            public modify::Modifier (p_oid : OID -> ArticuloCatalogo, p_nombre : String, p_coleccion : String, p_rareza : Rareza, p_precioReferencia : Moneda, p_habilitado : Boolean, p_porcentajeDescuento : Double, p_fechaFinDescuento : Date) : Void;
            public readOID::ReadOID (p_oid : OID -> ArticuloCatalogo) : Object -> ArticuloCatalogo;
            public readAll::ReadAll () : List<Object -> ArticuloCatalogo>;
            
            // Operaciones Custom
            public actualizarDescuentoArticulo::Custom (p_oid : OID -> ArticuloCatalogo, p_porcentaje : Double, p_fechaFin : Date) : Void;
        }
    };

    Class ActivoDigital
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private nombre : String (1, 1);
            private coleccion : String (1, 1);
            private precioEstimado : Moneda (1, 1);
            private atributos : AtributosSkin (1, 1);
            private enVenta : Boolean (1, 1);
            // blanca
            private unique identificadorUnico : String (1, 1);
        }
        
        operations
        {
            public new::New (p_nombre : String, p_coleccion : String, p_precioEstimado : Moneda, p_atributos : AtributosSkin, p_enVenta : Boolean, p_identificadorUnico : String, p_inventario_oid : OID -> InventarioPrivado) : Object -> ActivoDigital;
            public destroy::Destroy (p_oid : OID -> ActivoDigital) : Void;
            public modify::Modifier (p_oid : OID -> ActivoDigital, p_nombre : String, p_coleccion : String, p_precioEstimado : Moneda, p_atributos : AtributosSkin, p_enVenta : Boolean, p_identificadorUnico : String) : Void;
            public readOID::ReadOID (p_oid : OID -> ActivoDigital) : Object -> ActivoDigital;
            public readAll::ReadAll () : List<Object -> ActivoDigital>;
            
            // Operaciones Custom
            public bloquearParaVenta::Custom (p_oid : OID -> ActivoDigital) : Void;
            public desbloquear::Custom (p_oid : OID -> ActivoDigital) : Void;
            // Jorge
            public actualizarPrecio::Custom (p_oid : OID -> ActivoDigital, p_nuevoPrecio : Moneda) : Void;
            
            // blanca
            public marcarComoFavorito::Custom (p_oid : OID -> ActivoDigital, p_usuario_oid : OID -> Usuario) : Boolean;
            public verificarAutenticidad::Custom (p_oid : OID -> ActivoDigital) : Boolean;
            public generarReporteActividad::Custom (p_oid : OID -> ActivoDigital) : String;

            // ========================================================
            // FILTROS DE LECTURA (ReadFilter) - Jorge
            // ========================================================
            public filtrarActivosPorRareza::ReadFilter (p_rareza : Rareza) : List<Object -> ActivoDigital>
            {
                filterLinQ = "entity => entity.Atributos != null && entity.Atributos.Rareza == p_rareza"
            };
            public filtrarActivosPorColeccion::ReadFilter (p_coleccion : String) : List<Object -> ActivoDigital>
            {
                filterLinQ = "entity => entity.Coleccion == p_coleccion"
            };
            public filtrarActivosPorCondicion::ReadFilter (p_condicion : Condicion) : List<Object -> ActivoDigital>
            {
                filterLinQ = "entity => entity.Atributos != null && entity.Atributos.Condicion == p_condicion"
            };

            // blanca
            public filtrarActivosEnVenta::ReadFilter (p_usuarioId : Integer, p_enVenta : Boolean) : List<Object -> ActivoDigital>
            {
                filterLinQ = "entity => entity.Inventario.Usuario.Id == p_usuarioId && entity.EnVenta == p_enVenta"
            };
        }
    };

    // blanca
    Class Favorito
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private fechaMarcado : Date (1, 1);
        }

        operations
        {
            public new::New (p_fechaMarcado : Date, p_usuario_oid : OID -> Usuario, p_activoDigital_oid : OID -> ActivoDigital) : Object -> Favorito;
            public destroy::Destroy (p_oid : OID -> Favorito) : Void;
            public modify::Modifier (p_oid : OID -> Favorito, p_fechaMarcado : Date) : Void;
            public readOID::ReadOID (p_oid : OID -> Favorito) : Object -> Favorito;
            public readAll::ReadAll () : List<Object -> Favorito>;
        }
    };

    // blanca
    Class Intercambio
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private estado : EstadoIntercambio (1, 1);
            private fechaCreacion : Date (1, 1);
        }

        operations
        {
            public new::New (p_estado : EstadoIntercambio, p_fechaCreacion : Date, p_proponente_oid : OID -> Usuario, p_receptor_oid : OID -> Usuario) : Object -> Intercambio;
            public destroy::Destroy (p_oid : OID -> Intercambio) : Void;
            public modify::Modifier (p_oid : OID -> Intercambio, p_estado : EstadoIntercambio, p_fechaCreacion : Date) : Void;
            public readOID::ReadOID (p_oid : OID -> Intercambio) : Object -> Intercambio;
            public readAll::ReadAll () : List<Object -> Intercambio>;

            // blanca
            public iniciarIntercambio::CustomTransaction (p_proponente_oid : OID -> Usuario, p_receptor_oid : OID -> Usuario, p_activosOfrecidos_oids : List<OID -> ActivoDigital>, p_activosSolicitados_oids : List<OID -> ActivoDigital>) : Object -> Intercambio;
            public aceptarIntercambio::CustomTransaction (p_oid : OID -> Intercambio, p_receptor_oid : OID -> Usuario) : Void;
            public cancelarIntercambio::CustomTransaction (p_oid : OID -> Intercambio, p_usuario_oid : OID -> Usuario) : Void;
        }
    };

    // ==========================================
    // MERCADO TRANSACCIONAL (VENTAS Y RESENAS)
    // ==========================================

    Class Venta
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private precioVenta : Moneda (1, 1);
            private fechaPublicacion : Date (1, 1);
            private estadoVenta : EstadoVenta (1, 1);
        }
        
        operations
        {
            public new::New (p_precioVenta : Moneda, p_fechaPublicacion : Date, p_estadoVenta : EstadoVenta, p_vendedor_oid : OID -> Usuario, p_comprador_oid : OID -> Usuario, p_activoDigital_oid : OID -> ActivoDigital, p_transaccionCobro_oid : OID -> Transaccion, p_transaccionPago_oid : OID -> Transaccion) : Object -> Venta;
            public destroy::Destroy (p_oid : OID -> Venta) : Void;
            public modify::Modifier (p_oid : OID -> Venta, p_precioVenta : Moneda, p_fechaPublicacion : Date, p_estadoVenta : EstadoVenta, p_activoDigital_oid : OID -> ActivoDigital) : Void;
            public readOID::ReadOID (p_oid : OID -> Venta) : Object -> Venta;
            public readAll::ReadAll () : List<Object -> Venta>;
            
            // Operaciones Custom
            public publicarVenta::Custom (p_oid : OID -> Venta, p_activoDigital_oid : OID -> ActivoDigital) : Void;
            public editarPrecio::Custom (p_oid : OID -> Venta, p_nuevoPrecio : Moneda) : Void;
            public cancelarVenta::Custom (p_oid : OID -> Venta) : Void;
            // Jorge (sustituye a ejecutarCompra)
            public procesarCompraSkin::CustomTransaction (p_oid : OID -> Venta, p_comprador_oid : OID -> Usuario) : Void;

            // blanca
            public filtrarVentasPorEstado::ReadFilter (p_estado : EstadoVenta) : List<Object -> Venta>
            {
                filterLinQ = "entity => entity.EstadoVenta == p_estado"
            };
            public filtrarVentasPorPrecioMaximo::ReadFilter (p_precioMaximo : Double) : List<Object -> Venta>
            {
                filterLinQ = "entity => (double)entity.PrecioVenta.Valor <= p_precioMaximo"
            };
        }
    };

    Class ResenaVendedor
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private puntuacion : Integer (1, 1);
            private comentario : String (1, 1);
            private fecha : Date (1, 1);
            private oculta : Boolean (1, 1);
        }
        
        operations
        {
            public new::New (p_puntuacion : Integer, p_comentario : String, p_fecha : Date, p_oculta : Boolean, p_comprador_oid : OID -> Usuario, p_vendedor_oid : OID -> Usuario) : Object -> ResenaVendedor;
            public destroy::Destroy (p_oid : OID -> ResenaVendedor) : Void;
            public modify::Modifier (p_oid : OID -> ResenaVendedor, p_puntuacion : Integer, p_comentario : String, p_fecha : Date, p_oculta : Boolean) : Void;
            public readOID::ReadOID (p_oid : OID -> ResenaVendedor) : Object -> ResenaVendedor;
            public readAll::ReadAll () : List<Object -> ResenaVendedor>;
            
            // Operaciones Custom
            public moderarResena::Custom (p_oid : OID -> ResenaVendedor, p_admin_oid : OID -> Administrador) : Void;
            public ocultarResena::Custom (p_oid : OID -> ResenaVendedor) : Void;

            // ========================================================
            // FILTROS DE LECTURA (ReadFilter)
            // ========================================================
            public filtrarResenasVisiblesPorVendedor::ReadFilter (p_vendedorId : Integer) : List<Object -> ResenaVendedor>
            {
                filterLinQ = "entity => entity.Vendedor.Id == p_vendedorId && entity.Oculta == false"
            };
        }
    };


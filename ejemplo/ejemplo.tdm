    // ==========================================
    // AUDITORIA Y SEGURIDAD
    // ==========================================

    Class RegistroAuditoria
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private accion : String (1, 1);
            private fecha : Date (1, 1);
        }
        
        operations
        {
            public new::New (p_accion : String, p_fecha : Date, p_administrador_oid : OID -> Administrador) : Object -> RegistroAuditoria;
            public destroy::Destroy (p_oid : OID -> RegistroAuditoria) : Void;
            public readOID::ReadOID (p_oid : OID -> RegistroAuditoria) : Object -> RegistroAuditoria;
            public readAll::ReadAll () : List<Object -> RegistroAuditoria>;
        }
    };

    // ==========================================
    // ASOCIACIONES Y RELACIONES
    // ==========================================

    Association usuarioMonedero (Usuario - Monedero)
    {
        => navigable monedero : Composite (1, 1);
        <= navigable usuario (1, 1);
    };

    Association usuarioInventario (Usuario - InventarioPrivado)
    {
        => navigable inventario : Composite (1, 1);
        <= navigable usuario (1, 1);
    };

    Association inventarioActivo (InventarioPrivado - ActivoDigital)
    {
        => navigable activos : Composite (0, *);
        <= navigable inventario (1, 1);
    };

    Association monederoTransaccion (Monedero - Transaccion)
    {
        => navigable transacciones (0, *);
        <= navigable monedero (1, 1);
    };

    Association ventaVendedor (Usuario - Venta)
    {
        => navigable ventasPublicadas (0, *);
        <= navigable vendedor (1, 1);
    };

    Association ventaComprador (Usuario - Venta)
    {
        => navigable comprasRealizadas (0, *);
        <= navigable comprador (0, 1);
    };

    Association ventaActivo (Venta - ActivoDigital)
    {
        => navigable activoDigital (1, 1);
        <= navigable venta (0, 1);
    };

    Association ventaTransaccionCobro (Venta - Transaccion)
    {
        => navigable transaccionCobro (0, 1);
        <= navigable ventaCobro (0, 1);
    };

    Association ventaTransaccionPago (Venta - Transaccion)
    {
        => navigable transaccionPago (0, 1);
        <= navigable ventaPago (0, 1);
    };

    Association resenaComprador (Usuario - ResenaVendedor)
    {
        => navigable resenasRealizadas (0, *);
        <= navigable comprador (1, 1);
    };

    Association resenaVendedor (Usuario - ResenaVendedor)
    {
        => navigable resenasRecibidas (0, *);
        <= navigable vendedor (1, 1);
    };

    Association cajaProbabilidad (CajaMisteriosa - ProbabilidadDrop)
    {
        => navigable probabilidades : Composite (1, *);
        <= navigable caja (1, 1);
    };

    Association probabilidadActivo (ProbabilidadDrop - ActivoDigital)
    {
        => navigable activoRecompensa (1, 1);
        <= navigable probabilidad (0, *);
    };

    Association auditoriaAdministrador (Administrador - RegistroAuditoria)
    {
        => navigable registrosAuditoria (0, *);
        <= navigable administrador (1, 1);
    };

    // ---- NUEVAS ASOCIACIONES (Blanca) ----
    Association usuarioFavorito (Usuario - Favorito)
    {
        => navigable favoritos (0, *);
        <= navigable usuario (1, 1);
    };

    Association favoritoActivo (Favorito - ActivoDigital)
    {
        => navigable activoDigital (1, 1);
        <= navigable favoritosActivo (0, *);
    };

    Association intercambioProponente (Usuario - Intercambio)
    {
        => navigable intercambiosPropuestos (0, *);
        <= navigable proponente (1, 1);
    };

    Association intercambioReceptor (Usuario - Intercambio)
    {
        => navigable intercambiosRecibidos (0, *);
        <= navigable receptor (1, 1);
    };

    Association intercambioActivoOfrecido (Intercambio - ActivoDigital)
    {
        => navigable activosOfrecidos (0, *);
        <= navigable intercambioOfrecido (0, 1);
    };

    Association intercambioActivoSolicitado (Intercambio - ActivoDigital)
    {
        => navigable activosSolicitados (0, *);
        <= navigable intercambioSolicitado (0, 1);
    };
}
@* HARIA-WEB GENERATED sha256:0b7eeb2445ba88f3fa907cb1c4bfa1ed65a5f661ae2c52d03b499b288d09b333 *@
@model Skinlink.Web.ViewModels.ActivoDigitalViewModel

@{
    ViewData["Title"] = "Crear";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body p-4">
                <span class="badge text-bg-primary-subtle text-primary-emphasis mb-3">Crear</span>
                <h1 class="h3 mb-1">ActivoDigital</h1>
                <p class="text-body-secondary mb-0">Completa los campos y guarda los cambios.</p>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="card-body p-4">
                    <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Coleccion" class="form-label"></label>
            <input asp-for="Coleccion" class="form-control" />
            <span asp-validation-for="Coleccion" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="PrecioEstimadoValor" class="form-label"></label>
            <input asp-for="PrecioEstimadoValor" type="text" inputmode="decimal" asp-format="{0:G}" data-haria-number="true" data-haria-decimal="@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator" class="form-control" />
            <span asp-validation-for="PrecioEstimadoValor" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="PrecioEstimadoDivisa" class="form-label"></label>
            <input asp-for="PrecioEstimadoDivisa" class="form-control" />
            <span asp-validation-for="PrecioEstimadoDivisa" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="AtributosRareza" class="form-label"></label>
            <select asp-for="AtributosRareza" asp-items="Html.GetEnumSelectList<ejemplo.Domain.Enums.Rareza>()" class="form-select"></select>
            <span asp-validation-for="AtributosRareza" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="AtributosCondicion" class="form-label"></label>
            <select asp-for="AtributosCondicion" asp-items="Html.GetEnumSelectList<ejemplo.Domain.Enums.Condicion>()" class="form-select"></select>
            <span asp-validation-for="AtributosCondicion" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="AtributosFloatVal" class="form-label"></label>
            <input asp-for="AtributosFloatVal" type="text" inputmode="decimal" asp-format="{0:G}" data-haria-number="true" data-haria-decimal="@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator" class="form-control" />
            <span asp-validation-for="AtributosFloatVal" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="AtributosPatron" class="form-label"></label>
            <input asp-for="AtributosPatron" class="form-control" />
            <span asp-validation-for="AtributosPatron" class="text-danger"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="EnVenta" class="form-check-input" />
            <label asp-for="EnVenta" class="form-check-label"></label>
            <span asp-validation-for="EnVenta" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="IdentificadorUnico" class="form-label"></label>
            <input asp-for="IdentificadorUnico" class="form-control" />
            <span asp-validation-for="IdentificadorUnico" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="InventarioId" class="form-label"></label>
            <select asp-for="InventarioId" asp-items="Model.InventarioOptions" class="form-select"><option value="">Selecciona...</option></select>
            <span asp-validation-for="InventarioId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="VentaId" class="form-label"></label>
            <select asp-for="VentaId" asp-items="Model.VentaOptions" class="form-select"><option value="">Selecciona...</option></select>
            <span asp-validation-for="VentaId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="IntercambioOfrecidoId" class="form-label"></label>
            <select asp-for="IntercambioOfrecidoId" asp-items="Model.IntercambioOfrecidoOptions" class="form-select"><option value="">Selecciona...</option></select>
            <span asp-validation-for="IntercambioOfrecidoId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="IntercambioSolicitadoId" class="form-label"></label>
            <select asp-for="IntercambioSolicitadoId" asp-items="Model.IntercambioSolicitadoOptions" class="form-select"><option value="">Selecciona...</option></select>
            <span asp-validation-for="IntercambioSolicitadoId" class="text-danger"></span>
        </div>
                </div>
                <div class="card-footer bg-body p-4 d-flex flex-column flex-sm-row gap-2">
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/haria-numbers.js" asp-append-version="true"></script>

}

@* Fichero manual (Miembro 1): vista de la operación custom actualizarEstadoKYC (Administrador). *@
@model Skinlink.Web.ViewModels.ActualizarEstadoKYCViewModel
@{
    ViewData["Title"] = "Actualizar estado KYC";
}

<h1 class="h3">Actualizar estado KYC</h1>
<partial name="_MensajesOperacion" />
<p>Cambia el estado de la cuenta de un usuario. El cambio queda registrado en el registro de auditoría a tu nombre.</p>
<form asp-action="ActualizarEstadoKYC" method="post" style="max-width: 32rem">
    <div class="mb-3">
        <label for="p_usuario_oid" class="form-label">Usuario</label>
        <select id="p_usuario_oid" name="p_usuario_oid" class="form-select" required>
            <option value="">Selecciona un usuario…</option>
            @foreach (var usuario in Model.Usuarios)
            {
                <option value="@usuario.Value" selected="@(usuario.Value == Model.UsuarioId?.ToString())">@usuario.Text</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label for="p_nuevoEstado" class="form-label">Nuevo estado</label>
        <select id="p_nuevoEstado" name="p_nuevoEstado" class="form-select">
            @foreach (var estado in Enum.GetValues<ejemplo.Domain.Enums.EstadoCuenta>())
            {
                <option value="@estado" selected="@(estado == Model.NuevoEstado)">@estado</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Actualizar</button>
    <a asp-controller="RegistroAuditoria" asp-action="Index" class="btn btn-link">Ver registro de auditoría</a>
</form>

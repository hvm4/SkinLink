@* Fichero manual (Miembro 1): alta de un Administrador (subclase de Usuario): campos heredados + código de auditor. *@
@model Skinlink.Web.ViewModels.AdministradorViewModel
@{
    ViewData["Title"] = "Crear administrador";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-body p-4">
        <h1 class="h3 mb-1">Crear administrador</h1>
        <p class="text-body-secondary mb-0">Alta de un administrador (hereda de Usuario) con su código de auditor. Se le crean un monedero y un inventario vacíos.</p>
    </div>
    <form asp-action="Create" method="post">
        <div class="card-body p-4">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div style="max-width: 32rem">
                <h2 class="h6 mt-3">Datos heredados de Usuario</h2>
                <div class="mb-3">
                    <label asp-for="NombreUsuario" class="form-label">Nombre de usuario</label>
                    <input asp-for="NombreUsuario" class="form-control" />
                    <span asp-validation-for="NombreUsuario" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Correo" class="form-label">Correo</label>
                    <input asp-for="Correo" type="email" class="form-control" />
                    <span asp-validation-for="Correo" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Contrasena" class="form-label"></label>
                    <input asp-for="Contrasena" type="password" value="" autocomplete="new-password" required class="form-control" />
                    <span asp-validation-for="Contrasena" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="FechaNacimiento" class="form-label">Fecha de nacimiento</label>
                    <input asp-for="FechaNacimiento" type="date" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Estado" class="form-label">Estado</label>
                    <select asp-for="Estado" asp-items="Html.GetEnumSelectList<ejemplo.Domain.Enums.EstadoCuenta>()" class="form-select"></select>
                </div>
                <div class="row">
                    <div class="col mb-3">
                        <label asp-for="Nivel" class="form-label">Nivel</label>
                        <input asp-for="Nivel" class="form-control" />
                    </div>
                    <div class="col mb-3">
                        <label asp-for="Experiencia" class="form-label">Experiencia</label>
                        <input asp-for="Experiencia" class="form-control" />
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="FechaUltimoLogin" class="form-label">Último acceso</label>
                    <input asp-for="FechaUltimoLogin" type="date" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Idioma" class="form-label">Idioma</label>
                    <input asp-for="Idioma" class="form-control" />
                    <span asp-validation-for="Idioma" class="text-danger"></span>
                </div>
                <div class="form-check mb-2">
                    <input asp-for="TemaModoOscuro" class="form-check-input" />
                    <label asp-for="TemaModoOscuro" class="form-check-label">Tema oscuro</label>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="Verificado" class="form-check-input" />
                    <label asp-for="Verificado" class="form-check-label">Identidad verificada</label>
                </div>
                <h2 class="h6 mt-3">Datos propios de Administrador</h2>
                <div class="mb-3">
                    <label asp-for="CodigoAuditor" class="form-label">Código de auditor</label>
                    <input asp-for="CodigoAuditor" class="form-control" />
                    <span asp-validation-for="CodigoAuditor" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="card-footer bg-body p-4 d-flex flex-column flex-sm-row gap-2">
            <button type="submit" class="btn btn-primary">Crear</button>
            <a asp-controller="Usuario" asp-action="Index" class="btn btn-outline-secondary">Volver a usuarios</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model IEnumerable<Skinlink.Web.ViewModels.AdministradorViewModel>

@{
    ViewData["Title"] = "Administrador";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-body d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 p-4">
        <div>
            <h1 class="h3 mb-1">Administrador</h1>
            <p class="text-body-secondary mb-0">Consulta y gestiona los registros disponibles.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Crear</a>
    </div>
    <div class="card-body p-0">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">@Html.DisplayNameFor(model => model.CodigoAuditor)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Id)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.NombreUsuario)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Correo)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.FechaNacimiento)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Estado)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Nivel)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Experiencia)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.FechaUltimoLogin)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.TemaModoOscuro)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Idioma)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Verificado)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.FechaUltimaRecompensa)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.MonederoLabel)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.InventarioLabel)</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                            <td>@Html.DisplayFor(modelItem => item.CodigoAuditor)</td>
                            <td>@Html.DisplayFor(modelItem => item.Id)</td>
                            <td>@Html.DisplayFor(modelItem => item.NombreUsuario)</td>
                            <td>@Html.DisplayFor(modelItem => item.Correo)</td>
                            <td>@Html.DisplayFor(modelItem => item.FechaNacimiento)</td>
                            <td>@Html.DisplayFor(modelItem => item.Estado)</td>
                            <td>@Html.DisplayFor(modelItem => item.Nivel)</td>
                            <td>@Html.DisplayFor(modelItem => item.Experiencia)</td>
                            <td>@Html.DisplayFor(modelItem => item.FechaUltimoLogin)</td>
                            <td>@Html.DisplayFor(modelItem => item.TemaModoOscuro)</td>
                            <td>@Html.DisplayFor(modelItem => item.Idioma)</td>
                            <td>@Html.DisplayFor(modelItem => item.Verificado)</td>
                            <td>@Html.DisplayFor(modelItem => item.FechaUltimaRecompensa)</td>
                            <td>@Html.DisplayFor(modelItem => item.MonederoLabel)</td>
                            <td>@Html.DisplayFor(modelItem => item.InventarioLabel)</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Detalles</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                            </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center p-5">
            <h2 class="h5">Todavía no hay registros</h2>
            <p class="text-body-secondary">Crea el primer registro para comenzar.</p>
            <a asp-action="Create" class="btn btn-primary">Crear</a>
        </div>
    }
    </div>
</div>

@model ArticuloDescuentoViewModel
@{
    ViewData["Title"] = "Descuento de artículo";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-body p-4">
        <h1 class="h3 mb-1">Descuento temporal de un artículo</h1>
        <p class="text-body-secondary mb-0">Aplica un porcentaje de descuento a un artículo del catálogo hasta la fecha indicada.</p>
    </div>
    <form asp-action="ActualizarDescuentoArticulo" method="post">
        <div class="card-body p-4">
            <partial name="_MensajesOperacion" />
            @if (Model.Articulos.Count == 0)
            {
                <div class="alert alert-info mb-0">No hay artículos en el catálogo.</div>
            }
            else
            {
                <div style="max-width: 40rem;">
                    <div class="mb-3">
                        <label for="p_oid" class="form-label">Artículo</label>
                        <select id="p_oid" name="p_oid" class="form-select">
                            @foreach (var art in Model.Articulos)
                            {
                                <option value="@art.Id" selected="@(art.Id == Model.ArticuloId)">@art.Nombre (@art.Coleccion) · @art.PrecioReferenciaValor.ToString("0.00") @art.PrecioReferenciaDivisa</option>
                            }
                        </select>
                    </div>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label for="p_porcentaje" class="form-label">Descuento (%)</label>
                            <input id="p_porcentaje" name="p_porcentaje" type="text" inputmode="decimal"
                                   value="@Model.Porcentaje.ToString(System.Globalization.CultureInfo.CurrentCulture)"
                                   data-haria-number="true" data-haria-decimal="@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator"
                                   class="form-control" required />
                        </div>
                        <div class="col-sm-6">
                            <label for="p_fechaFin" class="form-label">Válido hasta</label>
                            <input id="p_fechaFin" name="p_fechaFin" type="date" value="@Model.FechaFin.ToString("yyyy-MM-dd")" class="form-control" required />
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="card-footer bg-body p-4 d-flex flex-column flex-sm-row gap-2">
            @if (Model.Articulos.Count > 0)
            {
                <button type="submit" class="btn btn-primary">Aplicar descuento</button>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">Volver al catálogo</a>
        </div>
    </form>
</div>

@if (Model.Articulos.Count > 0)
{
    <div class="card border-0 shadow-sm mt-4">
        <div class="card-header bg-body px-4 py-3">
            <h2 class="h5 mb-0">Descuentos actuales</h2>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light"><tr><th>Artículo</th><th>Precio</th><th>Descuento</th><th>Hasta</th></tr></thead>
                    <tbody>
                    @foreach (var art in Model.Articulos)
                    {
                        <tr>
                            <td>@art.Nombre</td>
                            <td>@art.PrecioReferenciaValor.ToString("0.00") @art.PrecioReferenciaDivisa</td>
                            <td>@(art.PorcentajeDescuento is double d && d > 0 ? d.ToString("0.##") + " %" : "—")</td>
                            <td>@(art.PorcentajeDescuento is double hay && hay > 0 && art.FechaFinDescuento is DateTime fin ? fin.ToString("dd/MM/yyyy") : "—")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

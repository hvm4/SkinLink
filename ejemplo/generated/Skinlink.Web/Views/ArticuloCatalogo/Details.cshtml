@model Skinlink.Web.ViewModels.ArticuloCatalogoViewModel

@{
    ViewData["Title"] = "Detalles";
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body p-4">
                <span class="badge text-bg-primary-subtle text-primary-emphasis mb-3">Detalles</span>
                <h1 class="h3 mb-1">ArticuloCatalogo</h1>
                <p class="text-body-secondary mb-0">Review the complete record information.</p>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0 gy-2">
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Id)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Id)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Nombre)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Nombre)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Coleccion)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Coleccion)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Rareza)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Rareza)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.PrecioReferenciaValor)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.PrecioReferenciaValor)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.PrecioReferenciaDivisa)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.PrecioReferenciaDivisa)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Habilitado)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Habilitado)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.PorcentajeDescuento)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.PorcentajeDescuento)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.FechaFinDescuento)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.FechaFinDescuento)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Imagen)</dt>
            <dd class="col-sm-8 col-lg-9">@if (!string.IsNullOrWhiteSpace(Model.Imagen))
                {
                    <img src="@Url.Content("~/" + Model.Imagen.TrimStart('/'))" alt="@Html.DisplayNameFor(model => model.Imagen)" class="img-thumbnail img-fluid" style="max-width: 320px; max-height: 240px;" />
                }
                else
                {
                    <span class="text-body-secondary">Sin imagen</span>
                }</dd>
                </dl>


            </div>
            <div class="card-footer bg-body p-4">
                <div class="d-flex flex-column flex-sm-row gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
            </div>
            </div>
        </div>
    </div>
</div>

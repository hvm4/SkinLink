@model CajaAperturaViewModel
@{
    ViewData["Title"] = Model.Caja.Nombre;
    var caja = Model.Caja;
    var puedePagar = Model.SaldoUsuario is double saldo
        && saldo >= caja.PrecioAperturaValor
        && string.Equals(Model.DivisaUsuario, caja.PrecioAperturaDivisa, StringComparison.OrdinalIgnoreCase);
    var puedeOperar = Model.Autenticado && caja.Activa && Model.Probabilidades.Count > 0;
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-body p-4">
        <h1 class="h3 mb-1">
            @caja.Nombre
            @if (!caja.Activa) { <span class="badge text-bg-secondary ms-2 align-middle fs-6">No disponible</span> }
        </h1>
        <p class="text-body-secondary mb-0">
            Precio de apertura: <strong>@caja.PrecioAperturaValor.ToString("0.00") @caja.PrecioAperturaDivisa</strong>.
            Consulta las probabilidades, simula una apertura gratis o ábrela con tu saldo.
        </p>
    </div>
    <div class="card-body p-4">
        <partial name="_MensajesOperacion" />

        @if (Model.Resultado is ActivoDigitalViewModel r)
        {
            <div class="card card-body mb-4 @(Model.ResultadoEsSimulacion ? "border-info" : "border-success")">
                <h2 class="h5 mb-2">@(Model.ResultadoEsSimulacion ? "Resultado de la simulación (no se ha cobrado ni guardado nada)" : "Has obtenido")</h2>
                <div class="d-flex gap-3 align-items-center">
                    @if (!string.IsNullOrWhiteSpace(r.Imagen))
                    {
                        <img src="@Url.Content("~/" + r.Imagen.TrimStart('/'))" alt="@r.Nombre" class="img-thumbnail" style="width: 120px;" />
                    }
                    <div>
                        <div class="fw-semibold">@r.Nombre</div>
                        <div>@r.Coleccion · @TextosDominio.Rareza(r.AtributosRareza) · @TextosDominio.Condicion(r.AtributosCondicion) (float @r.AtributosFloatVal.ToString("0.0000"))</div>
                        <div>Valor estimado: @r.PrecioEstimadoValor.ToString("0.00") @r.PrecioEstimadoDivisa</div>
                    </div>
                </div>
            </div>
        }

        <h2 class="h5">Probabilidades</h2>
        <div class="table-responsive mb-3">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th></th><th>Activo</th><th>Colección</th><th>Rareza</th><th class="text-end">Probabilidad</th></tr>
                </thead>
                <tbody>
                @foreach (var p in Model.Probabilidades)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(p.Imagen))
                            {
                                <img src="@Url.Content("~/" + p.Imagen.TrimStart('/'))" alt="@p.Nombre" style="width: 48px; height: 36px; object-fit: cover;" />
                            }
                        </td>
                        <td>@p.Nombre</td>
                        <td>@p.Coleccion</td>
                        <td><span class="badge @TextosDominio.ClaseRareza(p.Rareza)">@TextosDominio.Rareza(p.Rareza)</span></td>
                        <td class="text-end">@p.Porcentaje.ToString("0.##") %</td>
                    </tr>
                }
                </tbody>
                <tfoot>
                    <tr><th colspan="4">Total</th><th class="text-end">@Model.SumaPorcentajes.ToString("0.##") %</th></tr>
                </tfoot>
            </table>
        </div>
        @if (Model.Probabilidades.Count > 0 && Math.Abs(Model.SumaPorcentajes - 100) > 0.01)
        {
            <div class="alert alert-warning">Las probabilidades de esta caja no suman 100 %: el administrador debe revisarlas.</div>
        }

        @if (!Model.Autenticado)
        {
            <div class="alert alert-info mb-0"><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Inicia sesión</a> para simular o abrir la caja.</div>
        }
        else if (puedeOperar)
        {
            <p class="text-body-secondary mb-0">
                Tu saldo: @(Model.SaldoUsuario?.ToString("N2") ?? "—") @Model.DivisaUsuario
            </p>
            @if (!puedePagar)
            {
                <p class="text-danger small mt-2 mb-0">No tienes saldo suficiente (o en la misma divisa) para abrir esta caja.</p>
            }
        }
    </div>
    <div class="card-footer bg-body p-4 d-flex flex-column flex-sm-row gap-2">
        @if (puedeOperar)
        {
            <form asp-action="AbrirCajaSorpresa" method="post" class="m-0">
                <input type="hidden" name="p_oid" value="@caja.Id" />
                <input type="hidden" name="p_usuario_oid" value="0" />
                <button type="submit" class="btn btn-primary w-100" disabled="@(!puedePagar)">
                    Abrir por @caja.PrecioAperturaValor.ToString("0.00") @caja.PrecioAperturaDivisa
                </button>
            </form>
            <form asp-action="SimularApertura" method="post" class="m-0">
                <input type="hidden" name="p_oid" value="@caja.Id" />
                <button type="submit" class="btn btn-outline-primary w-100">Simular apertura (gratis)</button>
            </form>
        }
        <a asp-action="Buscar" class="btn btn-outline-secondary">Volver a las cajas</a>
    </div>
</div>

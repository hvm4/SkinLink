@* Fichero manual (no lo genera HARIA Web) — Miembro 4.
   cambiarVisibilidadInventario: alterna el inventario entre público y privado. *@
@model VisibilidadInventarioViewModel
@{
    ViewData["Title"] = "Visibilidad del inventario";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-body p-4">
        <h1 class="h3 mb-1">Visibilidad del inventario</h1>
        <p class="text-body-secondary mb-0">Decide si otros usuarios pueden ver tu colección.</p>
    </div>
    <div class="card-body p-4">
        <partial name="_MensajesOperacion" />

        <div class="card mb-4">
            <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="h5 mb-0">Tu inventario es</span>
                        @if (Model.EsPublico)
                        {
                            <span class="badge text-bg-success fs-6">Público</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary fs-6">Privado</span>
                        }
                    </div>
                    <p class="text-body-secondary mb-0">
                        @Model.NumeroActivos activos · valor estimado @TextosDominio.Precio(Model.ValorEstimado, Model.Divisa)
                    </p>
                    <p class="small text-body-secondary mb-0 mt-1">
                        @(Model.EsPublico
                            ? "Otros usuarios pueden ver tu colección, por ejemplo para proponerte intercambios."
                            : "Solo tú puedes ver tu colección.")
                    </p>
                </div>
                <form asp-action="CambiarVisibilidadInventario" method="post">
                    <input type="hidden" name="p_oid" value="@Model.InventarioId" />
                    <button type="submit" class="btn btn-primary">
                        @(Model.EsPublico ? "Hacerlo privado" : "Hacerlo público")
                    </button>
                </form>
            </div>
        </div>

        @if (Model.Otros.Count > 0)
        {
            <h2 class="h5">Inventarios de los usuarios</h2>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Usuario</th><th>Activos</th><th>Valor estimado</th><th>Visibilidad</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model.Otros)
                        {
                            <tr>
                                <td>@inv.Propietario</td>
                                <td>@inv.NumeroActivos</td>
                                <td>@TextosDominio.Precio(inv.ValorEstimado, inv.Divisa)</td>
                                <td>
                                    <span class="badge @(inv.EsPublico ? "text-bg-success" : "text-bg-secondary")">@(inv.EsPublico ? "Público" : "Privado")</span>
                                </td>
                                <td class="text-end">
                                    <form asp-action="CambiarVisibilidadInventario" method="post">
                                        <input type="hidden" name="p_oid" value="@inv.InventarioId" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Cambiar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

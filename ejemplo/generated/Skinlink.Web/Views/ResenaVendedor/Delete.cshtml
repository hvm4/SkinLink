            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Id)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Id)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Puntuacion)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Puntuacion)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Comentario)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Comentario)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Fecha)</dt>

@* Fichero manual (no lo genera HARIA Web) — Miembro 4.
   moderarResena: el administrador oculta o restaura reseñas; cada cambio queda en RegistroAuditoria. *@
@model ModeracionResenasViewModel
@{
    ViewData["Title"] = "Moderación de reseñas";
}

<h1 class="h3 mb-1">Moderación de reseñas</h1>
<p class="text-muted">Ocultar o restaurar una reseña cambia la reputación visible del vendedor y queda en el registro de auditoría.</p>
<partial name="_MensajesOperacion" />

@if (Model.Resenas.Count == 0)
{
    <p class="text-muted">No hay reseñas.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Vendedor</th>
                    <th>Comprador</th>
                    <th>Nota</th>
                    <th>Comentario</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var resena in Model.Resenas)
                {
                    <tr class="@(resena.Oculta ? "table-secondary" : null)">
                        <td class="text-nowrap">@resena.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td>
                            <a asp-action="FiltrarResenasVisiblesPorVendedor" asp-route-p_vendedorId="@resena.VendedorId">@resena.VendedorLabel</a>
                        </td>
                        <td>@resena.CompradorLabel</td>
                        <td class="text-nowrap">@resena.Puntuacion / 5</td>
                        <td>@resena.Comentario</td>
                        <td>
                            @if (resena.Oculta)
                            {
                                <span class="badge text-bg-secondary">Oculta</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">Visible</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="ModerarResena" method="post">
                                <input type="hidden" name="p_oid" value="@resena.Id" />
                                <button type="submit" class="btn btn-sm @(resena.Oculta ? "btn-outline-success" : "btn-outline-danger")">
                                    @(resena.Oculta ? "Restaurar" : "Ocultar")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

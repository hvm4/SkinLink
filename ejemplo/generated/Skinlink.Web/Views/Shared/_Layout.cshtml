<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d6efd" />
    <title>@ViewData["Title"] · Skinlink.Web</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Skinlink.Web.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-body-tertiary">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm" aria-label="Navegación principal">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">Skinlink.Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Mostrar u ocultar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Privacy">Privacidad</a></li>
                        @* Menú según el rol (Miembro 1). El menú solo muestra enlaces: el acceso lo controla [Authorize]. *@
                        <li class="nav-item"><a class="nav-link" asp-controller="ActivoDigital" asp-action="Buscar">Activos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="CajaMisteriosa" asp-action="Buscar">Cajas</a></li>
                        @if (User.IsInRole(Roles.Usuario) || User.EsAdministrador())
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Usuario" asp-action="Perfil">Mi perfil</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Usuario" asp-action="ReclamarRecompensaDiaria">Recompensa diaria</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Transaccion" asp-action="FiltrarTransaccionesPorRangoFechas">Mis movimientos</a></li>
                        }
                        @if (User.EsAdministrador())
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Administración</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Usuario" asp-action="Index">Usuarios</a></li>
                                    <li><a class="dropdown-item" asp-controller="Usuario" asp-action="FiltrarUsuariosPorEstado">Filtrar usuarios por estado</a></li>
                                    <li><a class="dropdown-item" asp-controller="Administrador" asp-action="ActualizarEstadoKYC">Actualizar estado KYC</a></li>
                                    <li><a class="dropdown-item" asp-controller="Administrador" asp-action="Index">Administradores</a></li>
                                    <li><a class="dropdown-item" asp-controller="RegistroAuditoria" asp-action="Index">Registro de auditoría</a></li>
                                    <li><a class="dropdown-item" asp-controller="ArticuloCatalogo" asp-action="Descuento">Descuentos del catálogo</a></li>
                                    @* Miembro 4 *@
                                    <li><a class="dropdown-item" asp-controller="ResenaVendedor" asp-action="Moderacion">Moderación de reseñas</a></li>
                                    <li><a class="dropdown-item" asp-controller="ConfiguracionSistema" asp-action="Comision">Comisión de mercado</a></li>
                                    <li><a class="dropdown-item" asp-controller="InventarioPrivado" asp-action="Visibilidad">Visibilidad de inventarios</a></li>
                                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Index">Todas las entidades</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-lg-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="navbar-text text-white-50 small">@User.GetNombreUsuario() (id @User.Identity.Name)@(User.EsAdministrador() ? " · Administrador" : User.EstaSuspendido() ? " · Cuenta suspendida" : "")</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-outline-light btn-sm">Cerrar sesión</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-light btn-sm" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                    }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container flex-grow-1 py-4 py-lg-5">
        @RenderBody()
    </main>

    <footer class="border-top bg-body py-3 mt-auto">
        <div class="container d-flex flex-column flex-sm-row justify-content-between gap-2 small text-body-secondary">
            <span>&copy; @DateTime.Now.Year Skinlink.Web</span>
            <a asp-controller="Home" asp-action="Privacy" class="link-secondary">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model Skinlink.Web.ViewModels.TransaccionFiltroFechasViewModel
@using Skinlink.Web.ViewModels
@{
    ViewData["Title"] = "Transacciones por rango de fechas";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-body p-4">
        <h1 class="h3 mb-1">Transacciones por rango de fechas</h1>
        <p class="text-body-secondary mb-0">
            @(Model.Buscado && Model.SoloMisMovimientos
                ? "Se muestran solo los movimientos de tu monedero."
                : "Indica el intervalo (ambos días incluidos).")
        </p>
    </div>
    <div class="card-body p-4">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <form asp-action="FiltrarTransaccionesPorRangoFechas" method="get" class="row g-3 align-items-end mb-4">
            <div class="col-sm-4">
                <label for="p_fechaInicio" class="form-label">Desde</label>
                <input id="p_fechaInicio" name="p_fechaInicio" type="date" class="form-control"
                       value="@Model.FechaInicio.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="col-sm-4">
                <label for="p_fechaFin" class="form-label">Hasta</label>
                <input id="p_fechaFin" name="p_fechaFin" type="date" class="form-control"
                       value="@Model.FechaFin.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="col-sm-4">
                <button type="submit" class="btn btn-primary">Filtrar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Ver todas</a>
            </div>
        </form>

        @if (Model.Buscado)
        {
            @if (!Model.Resultados.Any())
            {
                <div class="alert alert-info mb-0">No hay transacciones en ese intervalo.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Concepto</th>
                                <th>Monedero</th>
                                <th class="text-end">Importe</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.Resultados)
                            {
                                var entrada = TransaccionFiltroFechasViewModel.EsEntrada(t.Tipo);
                                <tr>
                                    <td>@t.Fecha.ToString("d")</td>
                                    <td>@t.Tipo</td>
                                    <td>@t.Concepto</td>
                                    <td>@t.MonederoLabel</td>
                                    <td class="text-end @(entrada ? "text-success" : "text-danger")">
                                        @(entrada ? "+" : "−")@t.MontoValor.ToString("N2") @t.MontoDivisa
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr><th colspan="4" class="text-end">Entradas</th><th class="text-end text-success">+@Model.TotalEntradas.ToString("N2") @Model.Divisa</th></tr>
                            <tr><th colspan="4" class="text-end">Salidas</th><th class="text-end text-danger">−@Model.TotalSalidas.ToString("N2") @Model.Divisa</th></tr>
                            <tr><th colspan="4" class="text-end">Balance</th><th class="text-end">@Model.Balance.ToString("N2") @Model.Divisa</th></tr>
                        </tfoot>
                    </table>
                </div>
            }
        }
    </div>
</div>

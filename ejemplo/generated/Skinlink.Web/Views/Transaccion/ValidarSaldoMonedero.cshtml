@model Skinlink.Web.ViewModels.OperacionMonederoViewModel
@{
    ViewData["Title"] = "Comprobar saldo";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-body p-4">
        <h1 class="h3 mb-1">Comprobar saldo de un monedero</h1>
        <p class="text-body-secondary mb-0">Indica si un monedero tiene saldo disponible suficiente, en la misma divisa, para cubrir un importe. No modifica nada.</p>
    </div>
    <form asp-action="ValidarSaldoMonedero" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="p_oid" value="0" />
        <div class="card-body p-4">
            <partial name="_MensajesOperacion" />

            @if (!Model.Monederos.Any())
            {
                <div class="alert alert-warning mb-0">No hay ningún monedero.</div>
            }
            else
            {
                <div class="mb-3">
                    <label for="p_monedero_oid" class="form-label">Monedero</label>
                    <select id="p_monedero_oid" name="p_monedero_oid" asp-items="Model.Monederos" class="form-select" required>
                        <option value="">Selecciona...</option>
                    </select>
                </div>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label for="p_monto_Valor" class="form-label">Importe requerido</label>
                        <input id="p_monto_Valor" name="p_montoRequerido.Valor" type="text" inputmode="decimal" data-haria-number="true" data-haria-decimal="@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator" class="form-control" required />
                    </div>
                    <div class="col-sm-6">
                        <label for="p_monto_Divisa" class="form-label">Divisa</label>
                        <input id="p_monto_Divisa" name="p_montoRequerido.Divisa" value="@Model.Divisa" maxlength="3" class="form-control" required />
                    </div>
                </div>
            }
        </div>
        @if (Model.Monederos.Any())
        {
            <div class="card-footer bg-body p-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Comprobar</button>
                <a asp-controller="Monedero" asp-action="Index" class="btn btn-outline-secondary">Volver a monederos</a>
            </div>
        }
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/haria-numbers.js" asp-append-version="true"></script>
}

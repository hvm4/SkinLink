@* Fichero manual (Miembro 1): vista del ReadFilter filtrarUsuariosPorEstado. *@
@model Skinlink.Web.ViewModels.UsuarioFiltroEstadoViewModel
@{
    ViewData["Title"] = "Filtrar usuarios por estado";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-body p-4">
        <h1 class="h3 mb-1">Filtrar usuarios por estado</h1>
        <p class="text-body-secondary mb-0">Elige el estado de las cuentas que quieres ver. Incluye a los administradores.</p>
    </div>
    <div class="card-body p-4">
        <partial name="_MensajesOperacion" />

        <form asp-action="FiltrarUsuariosPorEstado" method="get" class="row g-3 align-items-end mb-4">
            <div class="col-sm-6">
                <label for="p_estado" class="form-label">Estado de la cuenta</label>
                <select id="p_estado" name="p_estado" class="form-select">
                    @foreach (var estado in Enum.GetValues<ejemplo.Domain.Enums.EstadoCuenta>())
                    {
                        <option value="@estado" selected="@(estado == Model.Estado)">@estado</option>
                    }
                </select>
            </div>
            <div class="col-sm-6">
                <button type="submit" class="btn btn-primary">Filtrar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Ver todos</a>
            </div>
        </form>

        @if (Model.Buscado)
        {
            <p>@Model.Resultados.Count resultado(s) con estado <strong>@Model.Estado</strong>.</p>
            if (Model.Resultados.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>Id</th><th>Tipo</th><th>Nombre de usuario</th><th>Correo</th><th>Verificado</th><th>Nivel</th><th class="text-end">Acciones</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.Resultados)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@(Model.AdministradorIds.Contains(item.Id) ? "Administrador" : "Usuario")</td>
                                <td>@item.NombreUsuario</td>
                                <td>@item.Correo</td>
                                <td>@(item.Verificado ? "Sí" : "No")</td>
                                <td>@item.Nivel</td>
                                <td class="text-end"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Ver ficha</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

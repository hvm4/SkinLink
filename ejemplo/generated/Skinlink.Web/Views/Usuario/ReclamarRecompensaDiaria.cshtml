@* Fichero manual (Miembro 1): vista de la operación customTransaction reclamarRecompensaDiaria. *@
@model Skinlink.Web.ViewModels.ReclamarRecompensaViewModel
@{
    ViewData["Title"] = "Recompensa diaria";
}

<h1 class="h3">Recompensa diaria</h1>
<partial name="_MensajesOperacion" />
<p>Una vez al día puedes abrir gratis una caja misteriosa gratuita: recibirás una skin en tu inventario y 25 puntos de experiencia.</p>

@if (Model.YaReclamadoHoy)
{
    <div class="alert alert-info">Ya has reclamado la recompensa de hoy. Vuelve mañana.</div>
}
else if (Model.Cajas.Count == 0)
{
    <div class="alert alert-warning">Ahora mismo no hay ninguna caja gratuita activa.</div>
}
else
{
    <form asp-action="ReclamarRecompensaDiaria" method="post" style="max-width: 24rem">
        <input type="hidden" name="p_oid" value="@Model.UsuarioId" />
        <div class="mb-3">
            <label for="p_caja_oid" class="form-label">Caja gratuita</label>
            <select id="p_caja_oid" name="p_caja_oid" class="form-select" required>
                <option value="">Selecciona una caja…</option>
                @foreach (var caja in Model.Cajas)
                {
                    <option value="@caja.Value" selected="@(caja.Value == Model.CajaId?.ToString())">@caja.Text</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Reclamar</button>
    </form>
}
<p class="mt-3"><a asp-action="Perfil">Volver a mi perfil</a></p>

@model Skinlink.Web.ViewModels.ReclamarRecompensaViewModel
@{
    ViewData["Title"] = "Recompensa diaria";
    var puedeReclamar = !Model.YaReclamadoHoy && Model.Cajas.Count > 0;
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-body p-4">
        <h1 class="h3 mb-1">Recompensa diaria</h1>
        <p class="text-body-secondary mb-0">Una vez al día puedes abrir gratis una caja misteriosa gratuita: recibirás una skin en tu inventario y 25 puntos de experiencia.</p>
    </div>
    <form asp-action="ReclamarRecompensaDiaria" method="post">
        <div class="card-body p-4">
            <partial name="_MensajesOperacion" />
            @if (Model.YaReclamadoHoy)
            {
                <div class="alert alert-info mb-0">Ya has reclamado la recompensa de hoy. Vuelve mañana.</div>
            }
            else if (Model.Cajas.Count == 0)
            {
                <div class="alert alert-warning mb-0">Ahora mismo no hay ninguna caja gratuita activa.</div>
            }
            else
            {
                <input type="hidden" name="p_oid" value="@Model.UsuarioId" />
                <div class="mb-3" style="max-width: 24rem">
                    <label for="p_caja_oid" class="form-label">Caja gratuita</label>
                    <select id="p_caja_oid" name="p_caja_oid" class="form-select" required>
                        <option value="">Selecciona una caja…</option>
                        @foreach (var caja in Model.Cajas)
                        {
                            <option value="@caja.Value" selected="@(caja.Value == Model.CajaId?.ToString())">@caja.Text</option>
                        }
                    </select>
                </div>
            }
        </div>
        <div class="card-footer bg-body p-4 d-flex flex-column flex-sm-row gap-2">
            @if (puedeReclamar)
            {
                <button type="submit" class="btn btn-primary">Reclamar</button>
            }
            <a asp-action="Perfil" class="btn btn-outline-secondary">Volver a mi perfil</a>
        </div>
    </form>
</div>

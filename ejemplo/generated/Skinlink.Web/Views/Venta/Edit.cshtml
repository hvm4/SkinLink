@* HARIA-WEB GENERATED sha256:9daf28aa8ee11b7d8c4fa010ec3bce9dd9f16f77c522b2c2314a1324b3e9c9f1 *@
@model Skinlink.Web.ViewModels.VentaViewModel

@{
    ViewData["Title"] = "Editar";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body p-4">
                <span class="badge text-bg-primary-subtle text-primary-emphasis mb-3">Editar</span>
                <h1 class="h3 mb-1">Venta</h1>
                <p class="text-body-secondary mb-0">Completa los campos y guarda los cambios.</p>
            </div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="card-body p-4">
                    <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>
                    <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="PrecioVentaValor" class="form-label"></label>
            <input asp-for="PrecioVentaValor" type="text" inputmode="decimal" asp-format="{0:G}" data-haria-number="true" data-haria-decimal="@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator" class="form-control" />
            <span asp-validation-for="PrecioVentaValor" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="PrecioVentaDivisa" class="form-label"></label>
            <input asp-for="PrecioVentaDivisa" class="form-control" />
            <span asp-validation-for="PrecioVentaDivisa" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="FechaPublicacion" class="form-label"></label>
            <input asp-for="FechaPublicacion" type="date" class="form-control" />
            <span asp-validation-for="FechaPublicacion" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="EstadoVenta" class="form-label"></label>
            <select asp-for="EstadoVenta" asp-items="Html.GetEnumSelectList<ejemplo.Domain.Enums.EstadoVenta>()" class="form-select"></select>
            <span asp-validation-for="EstadoVenta" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="VendedorId" class="form-label"></label>
            <select asp-for="VendedorId" asp-items="Model.VendedorOptions" class="form-select"><option value="">Selecciona...</option></select>
            <span asp-validation-for="VendedorId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="CompradorId" class="form-label"></label>
            <select asp-for="CompradorId" asp-items="Model.CompradorOptions" class="form-select"><option value="">Selecciona...</option></select>
            <span asp-validation-for="CompradorId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ActivoDigitalId" class="form-label"></label>
            <select asp-for="ActivoDigitalId" asp-items="Model.ActivoDigitalOptions" class="form-select"><option value="">Selecciona...</option></select>
            <span asp-validation-for="ActivoDigitalId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="TransaccionCobroId" class="form-label"></label>
            <select asp-for="TransaccionCobroId" asp-items="Model.TransaccionCobroOptions" class="form-select"><option value="">Selecciona...</option></select>
            <span asp-validation-for="TransaccionCobroId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="TransaccionPagoId" class="form-label"></label>
            <select asp-for="TransaccionPagoId" asp-items="Model.TransaccionPagoOptions" class="form-select"><option value="">Selecciona...</option></select>
            <span asp-validation-for="TransaccionPagoId" class="text-danger"></span>
        </div>
                </div>
                <div class="card-footer bg-body p-4 d-flex flex-column flex-sm-row gap-2">
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/haria-numbers.js" asp-append-version="true"></script>

}

{
  "ConnectionStrings": {
    "DbConnection": "Data Source=../InitializeDB/ejemploBDD.db"
  },
  "HariaWeb": {
    "DomainModel": "../ejemplo.tdm",
    "DomainModelBaseDirectory": "..",
    "ViewModelsDirectory": "ViewModels",
    "SecurityUserClass": "Usuario",
    "Authentication": {
      "AllowSelfRegistration": true,
      "RolesByUserClass": {}
    },
    "Localization": {
      "DefaultCulture": "es-ES",
      "SupportedCultures": [
        "es-ES"
      ],
      "EnableCultureSelection": false
    },
    "Files": {
      "UploadRoot": "uploads",
      "MaxBytes": 5242880,
      "AllowedExtensions": [
        ".png",
        ".jpg",
        ".jpeg"
      ],
      "AllowedContentTypes": [
        "image/png",
        "image/jpeg"
      ],
      "DeleteReplacedFiles": true,
      "DeleteFilesOnEntityDelete": false
    }
  }
}
